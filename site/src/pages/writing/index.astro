---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Writing — Bingyuan Liu" description="Technical notes and other writing by Bingyuan Liu.">
	<div class="page container">
		<header>
			<h1>Writing</h1>
			<p>Technical notes, research perspectives, and occasional writing on other subjects.</p>
		</header>
		<ul aria-label="Articles">
			{posts.map((post) => (
				<li>
					<div>
						<h2><a href={`/writing/${post.id}/`}>{post.data.title}</a></h2>
						<p>{post.data.description}</p>
					</div>
					<time datetime={post.data.date.toISOString()}>{post.data.date.getFullYear()}</time>
				</li>
			))}
		</ul>
	</div>
</BaseLayout>

<style>
	.page { max-width: 850px; padding-top: 62px; padding-bottom: 90px; }
	header { max-width: 650px; margin-bottom: 42px; }
	h1 { margin: 0; font-size: clamp(1.85rem, 5vw, 2.5rem); font-weight: 650; letter-spacing: -0.035em; }
	header p { margin: 13px 0 0; color: var(--muted); }
	ul { margin: 0; padding: 0; list-style: none; }
	li { display: grid; grid-template-columns: 1fr auto; gap: 24px; padding: 22px 0 24px; border-top: 1px solid var(--line); }
	h2 { margin: 0; font-size: 1.02rem; font-weight: 580; line-height: 1.5; }
	h2 a { color: var(--text); text-decoration: none; }
	li p { max-width: 680px; margin: 3px 0 0; color: var(--muted); font-size: 0.88rem; }
	time { color: var(--faint); font-size: 0.8rem; }
</style>
