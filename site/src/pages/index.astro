---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { education, experience, publications } from '../data/profile';

const writing = (await getCollection('blog', ({ data }) => !data.draft))
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 3);
const featuredPublications = publications
	.filter((publication) => publication.featured)
	.sort((a, b) => Number(b.year) - Number(a.year));
---

<BaseLayout>
	<div class="home container">
		<section class="profile" aria-labelledby="profile-name">
			<figure>
				<img src="/images/bingyuan-liu.jpg" alt="Bingyuan Liu" width="358" height="500" />
			</figure>
			<div class="profile-content">
				<h1 id="profile-name">Bingyuan Liu</h1>
				<p class="role">AI researcher and engineer</p>
				<SocialLinks />
				<div class="bio">
					<p>I bridge AI research and production engineering, with more than a decade of experience across LLM/VLM post-training, multimodal understanding, computer vision, and recommender systems. My work ranges from research published at top venues such as CVPR to AI systems deployed at scale in real-world products.</p>
					<p>I am currently an Applied Scientist at Amazon (AWS AI / Amazon AGI), where I work on VLM post-training and multimodal systems for enterprise data. Previously, I was a Research Associate at <a href="https://www.etsmtl.ca/">ÉTS Montréal</a>. Earlier in my career, I held R&amp;D roles at companies such as Coohom and Alibaba, applying AI and machine learning to real-world products and systems.</p>
					<p>I received my Ph.D. from the Institute of Automation, Chinese Academy of Sciences, and my B.S. from Zhejiang University.</p>
				</div>
			</div>
		</section>

		<section class="home-section education" aria-labelledby="education-title">
			<h2 id="education-title">Education</h2>
			<div class="education-list">
				{education.map((item) => (
					<article>
						<p class="period">{item.period}</p>
						<div>
							<h3>{item.institution}</h3>
							<p>{item.degree}</p>
						</div>
					</article>
				))}
			</div>
		</section>

		<section id="experience" class="home-section" aria-labelledby="experience-title">
			<h2 id="experience-title">Work Experience</h2>
			<div class="experience-list">
				{experience.map((item) => (
					<article>
						<div class="experience-heading">
							<div>
								<h3>{item.organization}</h3>
								<p class="role-name">{item.role}</p>
							</div>
							<p class="experience-meta"><span>{item.period}</span><span>{item.location}</span></p>
						</div>
						<div class="experience-details">
							{item.details.length > 1 ? (
								<ul class="details">
									{item.details.map((detail, index) => {
										const link = item.detailLink?.index === index ? item.detailLink : undefined;
										if (!link) return <li>{detail}</li>;
										const [before, after] = detail.split(link.label);
										return <li>{before}<a href={link.href}>{link.label}</a>{after}</li>;
									})}
								</ul>
							) : (
								<p class="detail">{item.details[0]}</p>
							)}
						</div>
					</article>
				))}
			</div>
		</section>

		<section class="home-section" aria-labelledby="publications-title">
			<div class="section-title-row">
				<h2 id="publications-title">Selected publications</h2>
				<a href="/publications/">All publications</a>
			</div>
			<ol class="publication-list">
				{featuredPublications.map((publication) => (
					<li>
						<a class="publication-title" href={publication.paper}>{publication.title}</a>
						<p>{publication.venue}, {publication.year} · {publication.authorship}</p>
						<div class="publication-links">
							<a href={publication.paper}>Paper</a>
							{publication.code && <a href={publication.code}>Code</a>}
							{publication.dataset && <a href={publication.dataset}>Dataset</a>}
						</div>
					</li>
				))}
			</ol>
		</section>

		{writing.length > 0 && (
			<section class="home-section" aria-labelledby="writing-title">
				<div class="section-title-row">
					<h2 id="writing-title">Writing</h2>
					<a href="/writing/">All writing</a>
				</div>
				<ul class="writing-list">
					{writing.map((post) => (
						<li>
							<a href={`/writing/${post.id}/`}>{post.data.title}</a>
							<time datetime={post.data.date.toISOString()}>{post.data.date.getFullYear()}</time>
						</li>
					))}
				</ul>
			</section>
		)}

		<section id="contact" class="home-section contact" aria-labelledby="contact-title">
			<h2 id="contact-title">Contact</h2>
			<p>Email is the best way to reach me: <a href="mailto:liubingyuan1988@gmail.com">liubingyuan1988@gmail.com</a></p>
		</section>
	</div>
</BaseLayout>

<style>
	.home { max-width: 900px; }
	.profile { display: grid; grid-template-columns: 155px minmax(0, 1fr); gap: 44px; padding: 66px 0 62px; }
	.profile figure { margin: 4px 0 0; }
	.profile img { width: 155px; height: 155px; border-radius: 50%; object-fit: cover; object-position: center 28%; filter: saturate(0.82); }
	h1 { margin: 0; font-size: clamp(2rem, 5vw, 2.65rem); font-weight: 650; letter-spacing: -0.04em; line-height: 1.1; }
	.role { margin: 5px 0 14px; color: var(--muted); font-size: 1rem; }
	.bio { max-width: 690px; margin-top: 25px; }
	.bio p { margin: 0 0 13px; }
	.bio p:last-child { margin-bottom: 0; }
	.home-section { padding: 38px 0 46px; border-top: 1px solid var(--line); }
	.home-section > h2, .section-title-row h2 { margin: 0; font-size: 1.14rem; font-weight: 650; letter-spacing: -0.015em; }
	.section-title-row { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 11px; }
	.section-title-row > a { color: var(--muted); font-size: 0.78rem; text-decoration: none; }
	.experience-list { max-width: 760px; margin-top: 12px; }
	.experience-list article { padding: 20px 0; }
	.experience-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 28px; }
	.period { margin: 2px 0 0; color: var(--faint); font-size: 0.78rem; font-variant-numeric: tabular-nums; white-space: nowrap; }
	.experience-list h3 { margin: 0; font-size: 1.02rem; font-weight: 650; line-height: 1.4; }
	.role-name { margin: 1px 0 0; color: var(--muted); font-size: 0.86rem; }
	.experience-meta { display: flex; flex-direction: column; align-items: flex-end; flex: none; margin: 2px 0 0; color: var(--faint); font-size: 0.76rem; font-variant-numeric: tabular-nums; line-height: 1.5; }
	.experience-details { margin-top: 10px; }
	.detail { max-width: 700px; margin: 0; color: var(--muted); font-size: 0.89rem; line-height: 1.58; }
	.details { max-width: 700px; margin: 0; padding-left: 1.05rem; color: var(--muted); font-size: 0.89rem; line-height: 1.58; }
	.details li { margin: 5px 0; padding-left: 3px; }
	.details li::marker { color: var(--faint); font-size: 0.8em; }
	.publication-list { margin: 0; padding: 0; list-style: none; }
	.publication-list li { padding: 14px 0; }
	.publication-title { font-weight: 560; text-decoration: none; }
	.publication-list p { margin: 2px 0 0; color: var(--muted); font-size: 0.83rem; }
	.publication-links { display: flex; gap: 14px; margin-top: 4px; font-size: 0.78rem; }
	.publication-links a { text-decoration: none; }
	.writing-list { margin: 0; padding: 0; list-style: none; }
	.writing-list li { display: flex; justify-content: space-between; gap: 20px; padding: 11px 0; }
	.writing-list a { text-decoration: none; }
	.writing-list time { color: var(--faint); font-size: 0.8rem; }
	.contact { display: grid; grid-template-columns: 104px minmax(0, 1fr); gap: 23px; }
	.contact p { margin: 0; color: var(--muted); font-size: 0.9rem; }
	.education { display: grid; grid-template-columns: 104px minmax(0, 1fr); gap: 23px; }
	.education-list article { display: grid; grid-template-columns: 104px minmax(0, 1fr); gap: 23px; padding: 9px 0; }
	.education-list h3 { margin: 0; font-size: 0.96rem; font-weight: 620; line-height: 1.4; }
	.education-list article > div > p { margin: 1px 0 0; color: var(--muted); font-size: 0.86rem; }
	@media (max-width: 650px) {
		.profile { grid-template-columns: 1fr; gap: 23px; padding: 48px 0; }
		.profile img { width: 112px; height: 112px; }
		.education, .contact { grid-template-columns: 1fr; gap: 12px; }
		.experience-list article { padding: 18px 0; }
		.experience-heading { flex-direction: column; gap: 4px; }
		.experience-meta { align-items: flex-start; flex-direction: row; gap: 6px; }
		.experience-meta span + span::before { content: "· "; }
		.education-list article { grid-template-columns: 1fr; gap: 2px; padding: 6px 0; }
	}
</style>
