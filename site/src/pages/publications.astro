---
import BaseLayout from '../layouts/BaseLayout.astro';
import { publications } from '../data/profile';
---

<BaseLayout title="Publications — Bingyuan Liu" description="Selected publications by Bingyuan Liu across machine learning, computer vision, medical imaging, and language models.">
	<div class="page container">
		<header>
			<h1>Publications</h1>
			<p>Selected research in machine learning, computer vision, medical imaging, and language models. See <a href="https://scholar.google.com/citations?user=jrWPhioAAAAJ">Google Scholar</a> for the complete list.</p>
		</header>
		<ol aria-label="Selected publications">
			{publications.map((publication) => (
				<li>
					<h2><a href={publication.paper}>{publication.title}</a></h2>
					<p>{publication.venue}, {publication.year} · {publication.authorship}</p>
					{publication.achievement && (
						<p class="achievement">{publication.achievement}</p>
					)}
					<div>
						<a href={publication.paper}>Paper</a>
						{publication.code && <a href={publication.code}>Code</a>}
						{publication.dataset && <a href={publication.dataset}>Dataset</a>}
					</div>
				</li>
			))}
		</ol>
	</div>
</BaseLayout>

<style>
	.page { max-width: 850px; padding-top: 62px; padding-bottom: 90px; }
	header { max-width: 650px; margin-bottom: 42px; }
	h1 { margin: 0; font-size: clamp(1.85rem, 5vw, 2.5rem); font-weight: 650; letter-spacing: -0.035em; }
	header p { margin: 13px 0 0; color: var(--muted); }
	ol { margin: 0; padding: 0; list-style: none; }
	li { padding: 22px 0 24px; border-top: 1px solid var(--line); }
	h2 { max-width: 760px; margin: 0; font-size: 1.02rem; font-weight: 580; line-height: 1.5; }
	h2 a { color: var(--text); text-decoration: none; }
	li p { margin: 3px 0 8px; color: var(--muted); font-size: 0.84rem; }
	li .achievement { margin: -3px 0 8px; color: var(--text); font-size: 0.8rem; font-weight: 560; }
	li div { display: flex; gap: 14px; font-size: 0.8rem; }
	li div a { text-decoration: none; }
</style>
