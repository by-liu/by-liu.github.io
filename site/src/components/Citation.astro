---
interface Props { number: number; }
const { number } = Astro.props;
---

<sup class="citation"><a href={`#ref-${number}`} aria-label={`Jump to reference ${number}`}>[{number}]</a></sup>

<style>
	.citation { margin-left: 0.12em; font-size: 0.68em; font-weight: 650; line-height: 0; vertical-align: super; }
	a { color: var(--accent); text-decoration: none; }
	a:hover { color: var(--text); text-decoration: underline; text-underline-offset: 0.16em; }
</style>
