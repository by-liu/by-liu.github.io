---
const path = Astro.url.pathname;
const links = [
	{ href: '/#experience', label: 'Work Experience' },
	{ href: '/publications/', label: 'Publications' },
	{ href: '/writing/', label: 'Writing' },
	{ href: '/#contact', label: 'Contact' },
];
---

<header class="site-header">
	<div class="container header-inner">
		<a class="brand" href="/">Bingyuan Liu</a>
		<nav aria-label="Primary navigation">
			{links.map((link) => <a class:list={{ active: path === link.href }} href={link.href}>{link.label}</a>)}
		</nav>
	</div>
</header>

<style>
	.site-header { border-bottom: 1px solid var(--line); }
	.header-inner { display: flex; align-items: center; justify-content: space-between; min-height: 60px; }
	.brand { color: var(--text); font-size: 0.94rem; font-weight: 650; text-decoration: none; }
	nav { display: flex; gap: 24px; }
	nav a { color: var(--muted); font-size: 0.84rem; text-decoration: none; }
	nav a:hover, nav a.active { color: var(--text); }
	@media (max-width: 520px) {
		.header-inner { align-items: flex-start; flex-direction: column; gap: 8px; padding: 13px 0; }
		nav { gap: 18px; }
	}
</style>
