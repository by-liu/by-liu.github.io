---
import 'katex/dist/katex.min.css';
import BaseLayout from './BaseLayout.astro';
interface Heading { depth: number; slug: string; text: string; }
interface Props { title: string; description: string; date: Date; updated?: Date; type: 'technical' | 'essay' | 'note'; tags?: string[]; image?: string; draft?: boolean; headings?: Heading[]; }
const { title, description, date, updated, type, tags = [], image, draft = false, headings = [] } = Astro.props;
const typeLabel = type === 'technical' ? 'Technical note' : type === 'essay' ? 'Essay' : 'Note';
const sections = headings.filter((heading) => heading.depth === 2);
---

<BaseLayout title={`${title} — Bingyuan Liu`} description={description} image={image} type="article">
	<article class:list={['article', `article-${type}`]}>
		<header class="reading-container article-header">
			<a class="back" href="/writing/">← Writing</a>
			{draft && <p class="draft-notice">Local draft preview · not published</p>}
			<p class="eyebrow">{typeLabel}</p>
			<h1>{title}</h1>
			<p class="dek">{description}</p>
			<div class="meta">
				<span>Published <time datetime={date.toISOString()}>{date.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time></span>
				{updated && updated.valueOf() !== date.valueOf() && <span>Updated <time datetime={updated.toISOString()}>{updated.toLocaleDateString('en-CA', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</time></span>}
				{tags.length > 0 && <span>{tags.join(' · ')}</span>}
			</div>
		</header>
		{sections.length >= 3 && (
			<nav class="reading-container article-toc" aria-label="Table of contents">
				<p>On this page</p>
				<ol>
					{sections.map((section) => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}
				</ol>
			</nav>
		)}
		<div class="reading-container prose article-body"><slot /></div>
	</article>
</BaseLayout>

<style>
	.article { padding: 80px 0 110px; }
	.article-header { padding-bottom: 42px; border-bottom: 1px solid var(--line); }
	.back { display: inline-block; margin-bottom: 52px; color: var(--muted); font-size: 0.86rem; font-weight: 650; text-decoration: none; }
	.draft-notice { display: block; width: fit-content; margin: 0 0 18px; padding: 5px 9px; border: 1px solid var(--line); border-radius: 999px; color: var(--muted); font-size: 0.72rem; font-weight: 620; letter-spacing: 0.03em; }
	h1 { max-width: 760px; margin: 0; font-size: clamp(2.45rem, 7vw, 4.7rem); letter-spacing: -0.058em; line-height: 0.98; }
	.dek { max-width: 650px; margin: 26px 0 24px; color: var(--muted); font-size: 1.17rem; line-height: 1.6; }
	.meta { display: flex; flex-wrap: wrap; gap: 10px 24px; color: var(--faint); font-size: 0.83rem; }
	.article-toc { margin-top: 30px; padding: 18px 20px 19px; border: 1px solid var(--line); border-radius: var(--radius); background: var(--surface); }
	.article-toc > p { margin: 0 0 11px; color: var(--faint); font-size: 0.69rem; font-weight: 680; letter-spacing: 0.08em; text-transform: uppercase; }
	.article-toc ol { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 24px; margin: 0; padding: 0; list-style: none; counter-reset: section; }
	.article-toc li { display: grid; grid-template-columns: 1.7em 1fr; gap: 4px; min-width: 0; counter-increment: section; }
	.article-toc li::before { color: var(--faint); font-size: 0.72rem; font-variant-numeric: tabular-nums; content: counter(section, decimal-leading-zero); }
	.article-toc a { color: var(--muted); font-size: 0.8rem; line-height: 1.45; text-decoration: none; }
	.article-toc a:hover { color: var(--text); }
	.article-body { padding-top: 38px; }
	.article-essay .article-body { font-family: Iowan Old Style, Baskerville, Georgia, serif; font-size: 1.12rem; }
	@media (max-width: 600px) { .article { padding: 54px 0 80px; } .back { margin-bottom: 36px; } .article-toc ol { grid-template-columns: 1fr; } }
</style>
